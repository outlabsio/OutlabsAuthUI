# Cloudflare Workers static-assets headers. `nuxt generate` copies this file to
# .output/public/_headers; two scripts then finish the Content-Security-Policy line:
#
# - scripts/csp-hashes.mjs (run by `bun run generate`) replaces script-src with 'self' plus
#   the sha256 of every inline script in the generated HTML. Never add 'unsafe-inline': the
#   session tokens live in localStorage.
# - scripts/deploy-preflight.mjs (run by the deploy script) pins connect-src to the
#   deployment's API origin and adds its hosted logo origin to img-src.
#
# Until both have run, this policy only allows same-origin scripts and requests, so an
# unprepared artifact fails closed. Rules apply top to bottom; a later rule's "! Name" line
# removes a header an earlier rule set. Limits: 100 rules, 2,000 characters per line.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Content-hashed build assets never change under the same name.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Build manifests (latest.json, meta/<build>.json) keep their names across deployments, so
# Nuxt's newer-deployment check must always revalidate them.
/_nuxt/builds/*
  ! Cache-Control
  Cache-Control: no-cache

# Per-deployment config: always revalidate so a config change applies on the next load.
/app-config.json
  Cache-Control: no-cache
