{
  // Type-checks the Playwright suite and harness (`bun run typecheck:tests`). The Nuxt app has
  // its own project (.nuxt/tsconfig.*); E2E code runs in Node and must not use app aliases.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
