# Runtime app-config fallback (dev + CI). In production these are resolved from
# public/app-config.json at boot; env vars are the dev/E2E fallback. See
# app/utils/runtime-config.ts. Copy to .env for local dev, or drop a public/app-config.json.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8004
NUXT_PUBLIC_AUTH_API_PREFIX=/v1
# NUXT_PUBLIC_FRONTEND_PROFILE_KEY=auth-console
# NUXT_PUBLIC_APP_NAME=OutlabsAuth UI
# NUXT_PUBLIC_AUTH_BRAND=OutlabsAuth

# Playwright E2E — the disposable outlabsAuth backend the seeded suites talk to.
# Leave unset to run only the backend-free guest smoke.
# E2E_API_BASE_URL=http://localhost:8004
# E2E_AUTH_API_PREFIX=/v1
# E2E_ADMIN_EMAIL=admin@test.com
# E2E_ADMIN_PASSWORD=Test123!!
