{
  "name": "outlabs-auth-ui-nuxt",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.3"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate && node scripts/csp-hashes.mjs",
    "preview": "nuxt preview",
    "preview:static": "node scripts/deploy-preflight.mjs --local --config public/app-config.json && node scripts/serve-static.mjs --dir .output/public --port 3000",
    "release:check": "node scripts/release-check.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "deploy:cloudflare": "bash scripts/deploy-with-env.sh",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:guardrails": "vitest run test/unit/lint-guardrails.test.ts",
    "gen:api-types": "node scripts/gen-api-types.mjs",
    "check:api-types": "node scripts/gen-api-types.mjs --check",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auth": "playwright test e2e/auth",
    "test:e2e:app": "playwright test e2e/app",
    "test:e2e:users": "playwright test e2e/users",
    "test:e2e:roles": "playwright test e2e/roles",
    "test:e2e:permissions": "playwright test e2e/permissions",
    "test:e2e:api-keys": "playwright test e2e/api-keys",
    "test:e2e:entities": "playwright test e2e/entities",
    "test:e2e:audit": "playwright test e2e/audit",
    "test:e2e:settings": "playwright test e2e/settings",
    "test:e2e:account": "playwright test e2e/account",
    "test:e2e:a11y": "playwright test e2e/a11y",
    "test:e2e:static": "E2E_TARGET=static playwright test",
    "test:e2e:session": "playwright test --project=session",
    "test:unit": "vitest run",
    "typecheck:tests": "tsc -p e2e/tsconfig.json && vue-tsc -p test/unit/tsconfig.json --noEmit",
    "audit": "bun audit --ignore=GHSA-g7r4-m6w7-qqqr --ignore=GHSA-cp6q-959q-f8rh --ignore=GHSA-j95f-988m-3j2f --ignore=GHSA-86w9-cpqp-85rv --ignore=GHSA-vfj7-8cjw-p6xm"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.3",
    "@nuxt/ui": "4.11.0",
    "@pinia/colada": "1.4.2",
    "@pinia/colada-nuxt": "1.0.2",
    "@pinia/nuxt": "^1.0.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "maska": "^3.2.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.8.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.144.0"
  }
}
