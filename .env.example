# Dev-server fallback for the runtime app-config (`bun run dev` only). A public/app-config.json
# (copy public/app-config.template.json) wins over these, and production builds ignore them
# entirely: a deployed console reads only the app-config.json staged by the deploy preflight.
# See app/utils/runtime-config.ts. Copy to .env for local dev. Deploy credentials live in
# .env.deploy instead (see .env.deploy.example).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8004
NUXT_PUBLIC_AUTH_API_PREFIX=/v1
# Must equal a frontend profile key the backend registers (the enterprise example registers
# "console" and "portal"). Leave unset for a backend without frontend profiles; an unknown
# key makes every sign-in fail with wrong_application and emailed links go undelivered.
# NUXT_PUBLIC_FRONTEND_PROFILE_KEY=console
# NUXT_PUBLIC_APP_NAME=OutlabsAuth UI
# NUXT_PUBLIC_AUTH_BRAND=OutlabsAuth
# NUXT_PUBLIC_AUTH_LOGO_URL=/brand/outlabs-auth-logo.svg

# authUi — sign-in surface config (see README § authUi). Env values are strings; arrays are
# comma-separated. app-config.json may use proper JSON types instead.
# NUXT_PUBLIC_AUTH_UI_SIGNUP=true
# NUXT_PUBLIC_AUTH_UI_IDENTIFIER=email-or-phone   # or email-only
# NUXT_PUBLIC_AUTH_UI_DEFAULT_COUNTRY=AR
# NUXT_PUBLIC_AUTH_UI_CHANNELS=whatsapp,sms
# NUXT_PUBLIC_AUTH_UI_OAUTH_PROVIDERS=google,github
# NUXT_PUBLIC_AUTH_UI_MAGIC_LINK=true

# Playwright E2E — full guide: e2e/README.md. Leave E2E_API_BASE_URL unset to run only the
# backend-free smoke. When set, the backend preset is detected from /auth/config and persona
# credentials default to that example's seed (override per persona with E2E_<PERSONA>_EMAIL /
# E2E_<PERSONA>_PASSWORD, e.g. E2E_ADMIN_EMAIL, E2E_AGENT_EMAIL, E2E_ORG_ADMIN_EMAIL).
# Serve the console on a port the backend's CORS allowlist accepts (the examples allow 3000/3001).
# E2E_API_BASE_URL=http://localhost:8004
# E2E_AUTH_API_PREFIX=/v1
# E2E_PORT=3000
# E2E_TARGET=dev                       # or static: bun run generate + preflight + _headers (what the release check runs)
# E2E_ALLOW_DESTRUCTIVE_CLEANUP=1      # only against a disposable backend
# E2E_RESEED_CMD=                      # shell command that reseeds the disposable backend
# E2E_FRONTEND_PROFILE_KEY=console     # staged into the static target's app-config.json
# E2E_FRONTEND_PROFILES=enforced       # enforced|none; default: enforced on EnterpriseRBAC only

# Release check (bun run release:check; README "Releasing"). The two seeded example backends it
# gates on, both required (or pass --enterprise / --simple), and an optional reseed command run
# before each preset's suite (one for both, or one per preset).
# RELEASE_ENTERPRISE_API_BASE_URL=http://localhost:8004
# RELEASE_SIMPLE_API_BASE_URL=http://localhost:8003
# RELEASE_RESEED_CMD=
# RELEASE_ENTERPRISE_RESEED_CMD=
# RELEASE_SIMPLE_RESEED_CMD=
